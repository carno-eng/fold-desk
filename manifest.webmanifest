{
  "name": "Fold Desk",
  "short_name": "Fold Desk",
  "id": "./",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F3F5FA",
  "theme_color": "#F3F5FA",
  "lang": "ja",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "今日", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "時間割", "url": "./#timetable", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "ひとことで追加", "url": "./#ask", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
