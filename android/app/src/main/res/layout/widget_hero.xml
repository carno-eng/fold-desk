<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_hero" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="16dp" android:paddingBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C7FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:letterSpacing="-0.03" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="#FFFFFF" android:textSize="15.5sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                android:textColor="#FFFFFF" android:textSize="11.5sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:layout_width="92dp" android:layout_height="92dp" android:layout_marginStart="10dp">
            <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="残り時間" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                <Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="H:mm" android:format12Hour="H:mm"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone" />
                <TextView android:id="@+id/ringlabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="1日の流れ" />
    <LinearLayout android:id="@+id/barlabels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/barstart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#BFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/barend" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#BFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
