<?xml version="1.0" encoding="utf-8"?>
<!-- The blue "today" sheet from the app. Text sizes, the ring and which parts show are set in code from the widget's real size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_hero" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="15dp" android:paddingBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold" android:letterSpacing="-0.03" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#D9FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/sub2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:textColor="#D9FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/ring" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="残り時間" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                <Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="H:mm" android:format12Hour="H:mm"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone" />
                <TextView android:id="@+id/ringlabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/gap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/seg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:background="@drawable/bg_seg" android:orientation="horizontal" android:padding="3dp" android:visibility="gone">
        <TextView android:id="@+id/seg0" style="@style/Seg" />
        <TextView android:id="@+id/seg1" style="@style/Seg" />
        <TextView android:id="@+id/seg2" style="@style/Seg" />
        <TextView android:id="@+id/seg3" style="@style/Seg" />
    </LinearLayout>
    <ImageView android:id="@+id/bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:contentDescription="1日の流れ" />
    <LinearLayout android:id="@+id/barlabels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/barstart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#C7FFFFFF" android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/barend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textColor="#C7FFFFFF" android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone" />
</LinearLayout>
