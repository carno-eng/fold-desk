<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
    <ImageView android:id="@+id/check" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="8dp" android:padding="3dp"
        android:src="@drawable/ic_circle" android:contentDescription="完了にする" android:visibility="gone" />
    <TextView android:id="@+id/left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="38dp" android:layout_marginEnd="8dp"
        android:textColor="@color/accent" android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/card_fg" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/card_muted" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textColor="@color/card_muted" android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_soft" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:textColor="@color/accent" android:textSize="12.5sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
